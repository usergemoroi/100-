    "activityBarBadge.background": "#ff00ff",
    "sideBarTitle.foreground": "#e8e8f0",
    "sideBar.background": "#08080d",
    "sideBar.foreground": "#c0c0d0",
    "sideBar.border": "#1a1a2e",
    "tab.activeBackground": "#0a0a0f",
